# Server-only. Never commit .env.local or paste secrets into chat.
# Choose: openai, gemini, anthropic, openai-compatible. No automatic fallback.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
# Only for openai-compatible: trusted HTTPS API base URL including /v1 if needed.
# Groq: https://api.groq.com/openai/v1 ; OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=
# Compatible APIs: json_schema (preferred) or json_object (validated locally).
AI_OUTPUT_MODE=json_schema
# Legacy OpenAI configuration remains supported when AI_PROVIDER=openai.
OPENAI_API_KEY=
# Select a Structured Outputs-compatible model available to your account.
OPENAI_MODEL=gpt-4o-mini
# Legacy anonymous-session setting, not required for password accounts.
SESSION_SIGNING_SECRET=
# Optional: defaults to .afterclass inside this project (use an absolute path).
AFTERCLASS_DATA_DIR=
# Password accounts require local SQLite. Cloud adapter is not active for login.
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Required for deployment; exact origin, e.g. https://your-app.vercel.app
APP_ORIGIN=
# 0 = retain history until student deletion; positive values enable expiry.
DATA_RETENTION_DAYS=0
# Deployment-wide AI calls per hour, in addition to per-student limits.
AI_HOURLY_LIMIT=100